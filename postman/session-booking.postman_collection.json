{
  "info": {
    "name": "Session Booking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the folders in order (Teachers -> Users -> Sessions). IDs are stored in collection variables automatically."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = new Date(); d.setUTCDate(d.getUTCDate() + 1); d.setUTCHours(10, 0, 0, 0);",
          "pm.collectionVariables.set('startTime', d.toISOString());",
          "pm.collectionVariables.set('endTime', new Date(d.getTime() + 3600000).toISOString());",
          "pm.collectionVariables.set('dateTimestamp', String(d.getTime()));",
          "pm.collectionVariables.set('userEmail', 'user' + Date.now() + '@example.com');",
          "pm.collectionVariables.set('teacherEmail', 'teacher' + Date.now() + '@example.com');"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "teacherId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "startTime",
      "value": ""
    },
    {
      "key": "endTime",
      "value": ""
    },
    {
      "key": "dateTimestamp",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "teacherEmail",
      "value": ""
    }
  ],
